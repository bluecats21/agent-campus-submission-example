[
  {
    "doc_id": "D01",
    "title": "员工报销管理制度",
    "version_date": "2024-01-15",
    "scope": null,
    "priority": null,
    "snippets": [
      {
        "snippet_id": "D01_S1",
        "text": "为加强公司费用报销管理，规范报销流程，制定本制度。"
      },
      {
        "snippet_id": "D01_S2",
        "text": "报销范围包括：差旅费、交通费、餐饮费、办公用品费等因公产生的合理费用。"
      },
      {
        "snippet_id": "D01_S3",
        "text": "报销期限：员工应在费用发生后 <DAY_C> 天内提交报销申请，逾期不予受理。"
      },
      {
        "snippet_id": "D01_S4",
        "text": "审批流程：500 元以下由部门经理审批；500-5000 元由部门经理和财务总监审批；5000 元以上需总经理审批。"
      },
      {
        "snippet_id": "D01_S5",
        "text": "报销凭证：需提供合法有效的发票或收据，并附费用明细说明。"
      }
    ]
  },
  {
    "doc_id": "D03",
    "title": "差旅报销补充规定",
    "version_date": "2024-02-15",
    "scope": "差旅场景",
    "priority": null,
    "snippets": [
      {
        "snippet_id": "D03_S1",
        "text": "本规定适用于所有因公出差场景的费用报销。"
      },
      {
        "snippet_id": "D03_S2",
        "text": "出差前需在 OA 系统提交出差申请，经部门经理批准。"
      },
      {
        "snippet_id": "D03_S3",
        "text": "差旅报销需在出差结束后及时提交，逾期需说明原因。"
      },
      {
        "snippet_id": "D03_S4",
        "text": "特殊情况下（如偏远地区出差），报销期限可适当延长，需提前报备。"
      }
    ]
  },
  {
    "doc_id": "D04",
    "title": "年假管理制度",
    "version_date": "2023-12-01",
    "scope": null,
    "priority": null,
    "snippets": [
      {
        "snippet_id": "D04_S1",
        "text": "年假天数标准：工作满 1 年不满 10 年为 5 天/年；工作满 10 年不满 20 年为 10 天/年；工作满 20 年以上为 15 天/年。"
      },
      {
        "snippet_id": "D04_S2",
        "text": "年假申请流程：提前 3 天在 OA 系统提交申请，3 天以内由部门经理审批，3 天以上需 HR 审批。"
      },
      {
        "snippet_id": "D04_S3",
        "text": "年假使用规则：可分次使用，最小单位为 0.5 天；不可跨年累积，确因工作需要无法休假的，可申请延期至次年 3 月。"
      },
      {
        "snippet_id": "D04_S4",
        "text": "离职时未休年假按日工资 300% 补偿。"
      },
      {
        "snippet_id": "D04_S5",
        "text": "病假、事假累计超过 30 天的，当年年假自动取消。"
      }
    ]
  }
]
